{
  "manifest_version":3,
  "name":"NoClanker",
  "version":"0.1.0",
  "description":"Blocks LLM providers to regain your focus!",
  "author":"Abhishek",
  "permissions":[
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions":[
    "*://*/*"
  ],
  "background":{
    "scripts":["background.js"]
  },
  "web_accessible_resources":[
    {
      "resources":["blocked.html"],
      "matches":["<all_urls>"]
    }
  ] 
}
